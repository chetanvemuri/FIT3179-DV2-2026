{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tourists spend more on meals than on a bed",
    "subtitle": "Tourist spending in Australia, 2024–25 ($ billion)",
    "anchor": "start"
  },
  "width": 500,
  "height": 380,
  "data": {
    "url": "data/tourism_spend_by_product.csv"
  },
  "encoding": {
    "y": {
      "field": "product",
      "type": "nominal",
      "sort": null,
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontSize": 12,
        "labelLimit": 400,
        "grid": true,
        "gridColor": "#ece6dc"
      }
    },
    "x": {
      "field": "spend_bn",
      "type": "quantitative",
      "title": "$ billion",
      "scale": {
        "domain": [
          0,
          35
        ]
      },
      "axis": {
        "grid": false,
        "tickCount": 7,
        "domain": false,
        "labelColor": "#777",
        "titleColor": "#777"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.product === 'Accommodation services'",
            "value": "#dc5d36"
          },
          "value": "#00849e"
        },
        "tooltip": [
          {
            "field": "product",
            "type": "nominal",
            "title": "Spent on"
          },
          {
            "field": "spend_bn",
            "type": "quantitative",
            "title": "$ billion",
            "format": ".1f"
          }
        ],
        "size": {
          "condition": {
            "param": "hv",
            "empty": false,
            "value": 260
          },
          "value": 110
        }
      },
      "params": [
        {
          "name": "hv",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 11,
        "color": "#5b6770"
      },
      "encoding": {
        "text": {
          "field": "spend_bn",
          "type": "quantitative",
          "format": "$.1f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
