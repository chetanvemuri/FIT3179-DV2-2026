{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "No state has won back all of its international visitors",
    "subtitle": "July 2026 overseas arrivals as a share of the year you choose. Darker = closer to that level.",
    "anchor": "start"
  },
  "width": 780,
  "height": 600,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/intl_visitors_by_state.csv"
            },
            "key": "state",
            "fields": [
              "jul_2019",
              "jul_2025",
              "jul_2026"
            ]
          }
        },
        {
          "calculate": "datum.jul_2026 / datum.jul_2019",
          "as": "recovery"
        },
        {
          "calculate": "(datum.jul_2026 - datum.jul_2025) / datum.jul_2025",
          "as": "change_1yr"
        },
        {
          "calculate": "base === '2019' ? datum.recovery : datum.jul_2026 / datum.jul_2025",
          "as": "ratio"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "ratio",
          "type": "quantitative",
          "title": "July 2026 as a share of chosen year",
          "scale": {
            "range": [
              "#e3f1f3",
              "#0a5f70"
            ],
            "domain": [
              0.7,
              1
            ],
            "clamp": true
          },
          "legend": {
            "format": ".0%",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "jul_2026",
            "type": "quantitative",
            "title": "Visitors, July 2026",
            "format": ","
          },
          {
            "field": "jul_2019",
            "type": "quantitative",
            "title": "Visitors, July 2019",
            "format": ","
          },
          {
            "field": "jul_2025",
            "type": "quantitative",
            "title": "Visitors, July 2025",
            "format": ","
          },
          {
            "field": "recovery",
            "type": "quantitative",
            "title": "Share of 2019 level",
            "format": ".0%"
          },
          {
            "field": "change_1yr",
            "type": "quantitative",
            "title": "Change since July 2025",
            "format": "+.1%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/intl_visitors_by_state.csv"
      },
      "transform": [
        {
          "calculate": "datum.jul_2026 / (base === '2019' ? datum.jul_2019 : datum.jul_2025)",
          "as": "ratio"
        },
        {
          "calculate": "datum.abbr + ' ' + format(datum.ratio, '.0%')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.ratio > 0.85",
            "value": "#ffffff"
          },
          "value": "#1d2a30"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "base",
      "value": "2019",
      "bind": {
        "input": "radio",
        "options": [
          "2019",
          "2025"
        ],
        "labels": [
          "July 2019 (before COVID)",
          "July 2025 (a year ago)"
        ],
        "name": "Compare July 2026 with: "
      }
    }
  ]
}
