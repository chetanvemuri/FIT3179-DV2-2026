{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "New Zealand has overtaken China as our biggest source of visitors",
    "subtitle": "Short-term overseas visitors arriving in Australia in July 2026, top 10 countries",
    "anchor": "start"
  },
  "width": 600,
  "height": 300,
  "data": {
    "url": "data/top_countries.csv"
  },
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontSize": 12
      }
    },
    "x": {
      "field": "jul_2026",
      "type": "quantitative",
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.country === 'New Zealand' || datum.country === 'China'",
            "value": "#dc5d36"
          },
          "value": "#d9d1c4"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "jul_2026",
            "type": "quantitative",
            "title": "Visitors, July 2026",
            "format": ","
          },
          {
            "field": "jul_2019",
            "type": "quantitative",
            "title": "Visitors, July 2019",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#5b6770"
      },
      "encoding": {
        "text": {
          "field": "jul_2026",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}